{
  "name": "memreduct-mcp",
  "version": "0.2.1",
  "description": "MCP server that lets AI agents free RAM with the user's own Mem Reduct, without admin prompts.",
  "mcpName": "io.github.RepressedAlliance/memreduct-mcp",
  "author": "RepressedAlliance",
  "homepage": "https://github.com/RepressedAlliance/memreduct-mcp",
  "repository": { "type": "git", "url": "git+https://github.com/RepressedAlliance/memreduct-mcp.git" },
  "bugs": { "url": "https://github.com/RepressedAlliance/memreduct-mcp/issues" },
  "keywords": ["mcp", "mcp-server", "model-context-protocol", "memreduct", "mem-reduct", "windows", "memory", "ram", "claude-code", "codex"],
  "type": "module",
  "bin": { "memreduct-mcp": "dist/index.cjs" },
  "files": ["dist", "README.md", "README.zh-CN.md", "LICENSE"],
  "os": ["win32"],
  "engines": { "node": ">=18" },
  "scripts": {
    "build": "esbuild src/index.js src/hook.js --bundle --platform=node --target=node18 --format=cjs --outdir=dist --out-extension:.js=.cjs",
    "test": "node test/smoke.mjs",
    "test:policy": "node --test test/policy.test.mjs",
    "pack:mcpb": "npx -y @anthropic-ai/mcpb@2.1.2 pack . memreduct-mcp.mcpb"
  },
  "devDependencies": { "@modelcontextprotocol/sdk": "1.32.2", "esbuild": "0.28.2" },
  "license": "MIT"
}
